APP_NAME='Research Agent Service'
APP_VERSION=0.0.1

OPENAI_API_KEY=
SERPER_API_KEY=

OTEL_ENABLED=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

REQUEST_TIMEOUT_SECONDS=45



ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_DOCS=true

CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_URLS=5
CRAWLER_MAX_CONTENT_CHARS=50000
CRAWLER_MIN_CONTENT_CHARS=200
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_USER_AGENT=ResearchAgentService/0.1
CRAWLER_BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0

SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=20

LLM_MODEL=gpt-5.4-nano
LLM_MAX_INPUT_CHARS=12000
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2